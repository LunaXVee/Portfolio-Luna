---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import { Meteors } from "@/components/magicui/meteors";
import { InteractiveGridPattern } from "@/components/magicui/interactive-grid-pattern";
import { InteractiveHoverButton } from "@/components/magicui/interactive-hover-button";
import ProjectsSection from './ProjectsSection.astro';
import { AnimatedThemeToggler } from "@/components/magicui/animated-theme-toggler";
import AboutSection from './AboutSection.astro';
import { Dock, DockIcon } from "@/components/magicui/dock";
import { Home, Settings, Search } from "lucide-react";


---

	<!-- <div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" /> -->
	
	<!-- Meteors background effect
	<div class="meteors-container ">
		<Meteors client:idle  />
	</div> -->

	
	<div class="grid-container">
		<InteractiveGridPattern 
		  client:load
		  squares={[50, 50]} 
		  width={40} 
		  height={40}
		/>
	  </div>


	<main>

		<section id="hero">
			<div class="toggler">
			<AnimatedThemeToggler client:load /></div>

			<h1>
				Hi there! I'm Luna, I build <code><pre>cool stuff</pre></code> 
			</h1>
			<h1>for your business.</h1>
			
			<section id="links">
				<a href="/about" class="primary-button">
					<InteractiveHoverButton>About Me</InteractiveHoverButton>
				</a>
				<a href="/projects" class="tertiary-button">
					Projects
				</a>
				<a href="/resume.pdf" download="Vimbai_Resume.pdf" class="tertiary-button">
					Download CV
				</a>
				<a href="/contact" class="tertiary-button">
					Contact
				</a>
			</section>
			

		</section>
	
	</main>
			
	<a href="/contact" id="news" class="box">
		<svg width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg"
			><path
				d="M24.667 12c1.333 1.414 2 3.192 2 5.334 0 4.62-4.934 5.7-7.334 12C18.444 28.567 18 27.456 18 26c0-4.642 6.667-7.053 6.667-14Zm-5.334-5.333c1.6 1.65 2.4 3.43 2.4 5.333 0 6.602-8.06 7.59-6.4 17.334C13.111 27.787 12 25.564 12 22.666c0-4.434 7.333-8 7.333-16Zm-6-5.333C15.111 3.555 16 5.556 16 7.333c0 8.333-11.333 10.962-5.333 22-3.488-.774-6-4-6-8 0-8.667 8.666-10 8.666-20Z"
				fill="#111827"></path></svg
		>
		<h2>Have a specific project in mind?</h2>
		<p>
			From product design, personal websites to mobile applications, click here to learn more about how 
			we can bring your idea to life!
		</p>
	</a>
</div>

<style>
/* Replace your existing styles with these responsive improvements */

#background {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	z-index: -1;
	filter: blur(100px);
}

.toggler {
	display: flex;
	justify-content: center;
	width: 60px;
	height: 60px;
	margin-bottom: 3rem; /* Increased from 1rem to 3rem */
}

.grid-container {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100vh;
	z-index: 0;
	pointer-events: none;
}

.grid-container > * {
	width: 100% !important;
	height: 100% !important;
}

#container {
	font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
	min-height: 100vh;
	height: 100%;
}

main {
	min-height: 100vh;
	display: flex;
	justify-content: center;
	align-items: center;
	z-index: 0;
	padding: 1rem;
}

#hero {
	display: flex;
	align-items: flex-start;
	flex-direction: column;
	justify-content: center;
	padding: 1rem;
	z-index: 1;
	width: 100%;
	max-width: 1200px;
}

/* Responsive heading sizes */
h1 {
	font-size: clamp(2rem, 8vw, 4rem); /* Scales from 32px to 64px */
	margin-top: 0.25em;
	font-weight: bold;
	line-height: 1.2;
	word-break: break-word;
}

#links {
	display: flex;
	gap: 1rem;
	flex-wrap: wrap;
	margin-top: 2rem;
	width: 100%;
}

#links a {
	display: flex;
	align-items: center;
	padding: 0.75rem 1rem;
	color: #111827;
	text-decoration: none;
	transition: color 0.2s;
	font-size: clamp(1rem, 4vw, 1.5rem); /* Scales from 16px to 24px */
	border-radius: 8px;
	white-space: nowrap;
}

#links a:hover {
	color: rgb(78, 80, 86);
}

#links a svg {
	height: 1em;
	margin-left: 8px;
	flex-shrink: 0;
}

#links a.button {
	color: white;
	background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
	box-shadow:
		inset 0 0 0 1px rgba(255, 255, 255, 0.12),
		inset 0 -2px 0 rgba(0, 0, 0, 0.24);
	border-radius: 10px;
}

#links a.button:hover {
	color: rgb(230, 230, 230);
	box-shadow: none;
}

:root.dark #links a {
	color: white;
}

:root.dark #links a:hover {
	color: #d1d5db;
}

pre {
	font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
	font-weight: normal;
	background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
	background-clip: text;
	margin: 0;
	display: inline;
}

h2 {
	margin: 0 0 1em;
	font-weight: normal;
	color: #111827;
	font-size: clamp(1.125rem, 3vw, 1.25rem);
}

p {
	color: #4b5563;
	font-size: clamp(0.875rem, 2.5vw, 1rem);
	line-height: 1.6;
	letter-spacing: -0.006em;
	margin: 0;
}

code {
	display: inline-block;
	background:
		linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
		linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
	border-radius: 8px;
	border: 1px solid transparent;
	padding: 0.375rem 0.5rem;
}

.box {
	padding: 1rem;
	background: rgba(255, 255, 255, 1);
	border-radius: 16px;
	border: 1px solid white;
}

#news {
	position: fixed;
	bottom: 1rem;
	right: 1rem;
	max-width: min(300px, calc(100vw - 2rem));
	text-decoration: none;
	transition: background 0.2s;
	backdrop-filter: blur(50px);
	z-index: 10;
}

#news:hover {
	background: rgba(255, 255, 255, 0.55);
}

/* Mobile-specific adjustments */
@media screen and (max-width: 768px) {
	main {
		padding: 0.5rem;
		align-items: flex-start;
		padding-top: 2rem;
	}

	#hero {
		padding: 0.5rem;
		align-items: center;
		text-align: center;
	}

	.toggler {
		margin-bottom: 4rem; /* Even more space on mobile */
	}

	#links {
		justify-content: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	#links a {
		padding: 0.75rem 1rem;
		font-size: 1rem;
		min-width: fit-content;
	}

	#news {
		position: fixed;
		bottom: 1rem;
		left: 1rem;
		right: 1rem;
		max-width: none;
	}

	h1 {
		text-align: center;
		margin-bottom: 0.5rem;
	}
}

/* Very small screens */
@media screen and (max-width: 480px) {
	main {
		padding: 0.25rem;
	}

	#hero {
		padding: 0.25rem;
	}

	#links {
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	#links a {
		width: 100%;
		max-width: 280px;
		justify-content: center;
		padding: 1rem;
	}

	.toggler {
		margin-bottom: 2rem; /* Reduced space on very small screens */
	}
}

/* Hide news box on very short screens */
@media screen and (max-height: 500px) {
	#news {
		display: none;
	}
}

/* Landscape mobile adjustments */
@media screen and (max-width: 768px) and (orientation: landscape) {
	main {
		padding-top: 1rem;
	}

	#hero {
		align-items: flex-start;
		text-align: left;
	}

	h1 {
		text-align: left;
		font-size: clamp(1.5rem, 6vw, 2.5rem);
	}

	#links {
		justify-content: flex-start;
		flex-direction: row;
		flex-wrap: wrap;
	}
}

@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Unbounded:wght@200..900&display=swap');	@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Unbounded:wght@200..900&display=swap');
</style>
