---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import { Meteors } from "@/components/magicui/meteors";
import { InteractiveGridPattern } from "@/components/magicui/interactive-grid-pattern";
import { InteractiveHoverButton } from "@/components/magicui/interactive-hover-button";
import ProjectsSection from './ProjectsSection.astro';
import { AnimatedThemeToggler } from "@/components/magicui/animated-theme-toggler";
import Navbar from "../components/NavBar.jsx";
import LatestWorks from '../components/LatestWorks.jsx';
import ContactForm from '../components/ContactForm.jsx'; // ← Add this import



---

  
<Navbar client:load />

	<main>
		<div class="about-content">

    <!-- Left side text -->
    <div class="left-text">
        <h1>Hey There,</h1>
        <h1>I'm Luna</h1>
        <p>majahav@africau.edu</p>
        <div class="experience">
            <span class="number">4</span>
            <span class="label">Years Experience</span>
        </div>
    </div>
    
    <!-- Center image -->
    <div class="center-image">
        <img src="/images/lastlast.png" alt="Luna" />
    </div>
    
    <!-- Right side text -->
    <div class="right-text">
        <h2>I build beautiful and efficient AI systems</h2>
        <div class="certification">
            <div class="cert-badge"><!-- Your badge/icon --></div>
            <p>Certified Professional in Cyber Security</p>
        </div>
    </div>
</div>
	
</div>
</main>
<!-- What Do I Help Section -->
<section class="help-section">
    <div class="help-container">
        <!-- Left Column - Services and Stats -->
        <div class="help-left">
            <!-- Services List -->
            <div class="services-list">
                <div class="service-item">
                    <div class="service-icon teal">
                        <img src="/images/monitor.svg" alt="Website Design" class="service-svg" />
                    </div>
                    <div class="service-content">
                        <h3 class="service-title">Website & Databse Design</h3>
                        <p class="service-count">76 Projects</p>
                    </div>
                </div>

                <div class="service-item">
                    <div class="service-icon yellow">
						<svg viewBox="0 0 24 24">
                            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                            <line x1="12" y1="18" x2="12.01" y2="18"/>
                        </svg>                    </div>
                    <div class="service-content">
                        <h3 class="service-title">Mobile App Design</h3>
                        <p class="service-count">63 Projects</p>
                    </div>
                </div>

                <div class="service-item">
                    <div class="service-icon orange">
                        <img src="/images/slack.svg" alt="Brand Identity" class="service-svg" />
                    </div>
                    <div class="service-content">
                        <h3 class="service-title">AI Workflow Integration</h3>
                        <p class="service-count">47 Projects</p>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="stats-container">
                <div class="stat-item">
                    <div class="stat-number">12+</div>
                    <div class="stat-label">Project Completed</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">8+</div>
                    <div class="stat-label">Happy Clients</div>
                </div>
            </div>
        </div>

        <!-- Right Column - Title and Description -->
        <div class="help-right">
            <h2 class="help-title">Who am I?</h2>
            <p class="help-description">
                I am a Computer Science student who builds digital solutions that help solve your business problems. I specialize in AI and machine learning, complemented by hands-on experience through UNESCO's African Women in Tech and AI summer program. 
            </p>
            <p class="help-description">
				I'm assionate about developing innovative technological solutions that address real-world challenges, particularly in education and digital transformation. Strong foundation in problem-solving with a focus on creating accessible, user-centered applications.            </p>
        </div>
    </div>
</section>
<section class="latest-works-section">
			 <!-- Latest Works Section -->
			 <LatestWorks client:load />
</section>

<!-- Contact Form Section - Add this new section -->
<section class="contact-section">
    <ContactForm client:only="react" />
</section>

<style>
	.latest-works-section {
    background: #F8F7F2;

}
.contact-section {
    background: #ffffff;
}

main{
	background: #F8F7F2;
}	

.about-content {
    display: grid;
    grid-template-columns: 1fr auto 1fr; /* left flexible, center auto-size, right flexible */
    gap: 2rem;
    align-items: center;
    max-width: auto;
	height: fit-content;
}

.left-text {
    text-align: right; /* Align text toward the center image */
    padding-right: 1rem; /* Small gap from the image */
}

.left-text h1 {
    font-size: 3rem;
    font-weight: 800;
    color: #0A3044;
    margin-bottom: 0.5rem;
    line-height: 1.1;
}

.left-text p {
    color: #0A3044; /* Green color for email like in your design */
    font-size: 1rem;
    margin-bottom: 2rem;
    text-decoration: underline;
}

.experience {
    display: flex;
    flex-direction: column;
    align-items: flex-end; /* Align to right since text-align is right */
}

.experience .number {
    font-size: 4rem;
    font-weight: 900;
    color: #0A3044;
    line-height: 1;
}

.experience .label {
    font-size: 1.1rem;
    color: #0A3044;
    font-weight: 500;
}

.center-image {
    display: flex;
    justify-content: center;
    align-items: center;
}

.center-image img {
    width: 500px; /* Adjust size as needed */
    height: 500px;
    object-fit: cover;
}

.center-image img:hover {
    transform: scale(1.02);
}

.right-text {
    text-align: left; /* Align text away from center */
    padding-left: 7rem; /* Small gap from the image */
}

.right-text h2 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #0A3044;
    line-height: 1.2;
    margin-bottom: 3rem;
}

.certification {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.cert-badge {
    width: 80px;
    height: 80px;
    border: 3px solid #1e293b;
    border-radius: 50%;
    margin-bottom: 1rem;
    /* Add your tree/badge icon styling here */
}

.certification p {
    font-size: 1.1rem;
    color: #64748b;
    font-weight: 500;
    text-align: center;
    max-width: 200px;
}

.help-section {
    background: #ffffff;
    padding: 100px 0 80px 0; /* Extra top padding for spacing from first section */
}

.help-container {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Two equal columns */
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    align-items: start;
}

.help-left {
    padding-right: 2rem;
}

.help-right {
    padding-left: 2rem;
}

.help-title {
    font-size: 3.5rem;
    font-weight: 700;
    color: #0A3044;
    margin-bottom: 2rem;
    line-height: 1.2;
    font-family: 'Poppins', sans-serif;
}

.help-description {
    color: #6c757d;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-family: 'Poppins', sans-serif;
}

.services-list {
    margin-bottom: 3rem;
}

.service-item {
    display: flex;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(10, 48, 68, 0.1);
}

.service-item:last-child {
    border-bottom: none;
}

.service-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 1.5rem;
    flex-shrink: 0;
}

.service-icon.teal {
    background-color: #20b2aa;
}

.service-icon.yellow {
    background-color: #ffd700;
}

.service-icon.orange {
    background-color: #ff6b47;
}

.service-icon svg {
    width: 24px;
    height: 24px;
    stroke: white;
    fill: none;
    stroke-width: 2;
}

/* Add this missing CSS for your SVG images */
.service-svg {
    width: 24px;
    height: 24px;
    filter: brightness(0) invert(1); /* Makes SVG icons white */
}

.service-content {
    flex: 1;
}

.service-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #0A3044;
    margin-bottom: 0.25rem;
    font-family: 'Poppins', sans-serif;
}

.service-count {
    color: #6c757d;
    font-size: 0.9rem;
    font-family: 'Poppins', sans-serif;
}

.stats-container {
    display: flex;
    gap: 3rem;
}

.stat-item {
    text-align: left;
}

.stat-number {
    font-size: 3rem;
    font-weight: 700;
    color: #0A3044;
    margin-bottom: 0.5rem;
    font-family: 'Poppins', sans-serif;
    line-height: 1;
}

.stat-label {
    color: #6c757d;
    font-size: 0.9rem;
    font-weight: 500;
    font-family: 'Poppins', sans-serif;
}



/* Responsive Design */
@media screen and (max-width: 1024px) {
    .help-container {
        grid-template-columns: 1fr;
        gap: 3rem;
        text-align: center;
    }
    
    .help-left,
    .help-right {
        padding: 0;
    }
    
    .help-title {
        font-size: 2.5rem;
    }
    
    .stats-container {
        justify-content: center;
        gap: 2rem;
    }
}

@media screen and (max-width: 768px) {
    .help-section {
        padding: 80px 0 60px 0;
    }
    
    .help-container {
        padding: 0 1rem;
        gap: 2rem;
    }
    
    .help-title {
        font-size: 2rem;
    }
    
    .service-icon {
        width: 50px;
        height: 50px;
        margin-right: 1rem;
    }
    
    .service-svg {
        width: 20px;
        height: 20px;
    }
    
    .stat-number {
        font-size: 2.5rem;
    }
    
    .stats-container {
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
    }
}
@media screen and (max-width: 1024px) {
    .about-content {
        grid-template-columns: 1fr; /* Stack vertically on smaller screens */
        text-align: center;
        gap: 2rem;
    }
    
    .left-text, .right-text {
        text-align: center;
        padding: 0;
    }
    
    .experience, .certification {
        align-items: center;
    }
}

	@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Unbounded:wght@200..900&display=swap');
</style>
