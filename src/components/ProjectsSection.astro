---
// src/components/ProjectsSection.astro
import ProjectsGrid from './ProjectsGrid.tsx';
import { projects } from '../data/projectsData.ts';
import Navbar from "../components/NavBar.jsx";

---

<Navbar client:load />

<section class="py-20 px-4 max-w-7xl mx-auto">
  <h2 class="text-4xl font-['Fustat'] font-semibold text-left mb-12 text-white dark:text-neutral-200">
    My Latest Work
  </h2>
  <h3 class="text-2xl text-left mb-12 text-neutral-300 dark:text-neutral-200">
    Each project is a testament of my learning journey</h3>
  
  <ProjectsGrid projects={projects} client:load />
</section>

