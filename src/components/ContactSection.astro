---

import Navbar from "../components/NavBar.jsx";
import LatestWorks from '../components/LatestWorks.jsx';
import ContactForm from '../components/ContactForm.jsx'; // ← Add this import
import Footer from '../components/Footer.jsx'; // ← Add this import
import { Highlighter } from "@/components/magicui/highlighter";
import BioSection from '../components/BioSection.jsx'; // ← Add this
import ScrollingTechStack from '../components/ScrollingTechStack.jsx';




---

  
<Navbar client:load />
<!-- Contact Form Section - Add this new section -->
<section class="contact-section">
    <ContactForm client:only="react" />
</section>

<!-- Footer Section -->
<section class="footer-section">
    <Footer />
</section>



<style>
	/* Add these animations to your existing <style> section */

.tech{
    background-color: #09090B;
    color: #F8F7F2;
}
@keyframes fadeInHighlight {
  0% {
    background-size: 0% 100%;
    opacity: 0;
  }
  100% {
    background-size: 100% 100%;
    opacity: 1;
  }
}

@keyframes slideInUnderline {
  0% {
    border-bottom-width: 0px;
  }
  100% {
    border-bottom-width: 3px;
  }
}

@keyframes fadeInBox {
  0% {
    border-color: transparent;
    transform: scale(0.95);
  }
  100% {
    border-color: currentColor;
    transform: scale(1);
  }
}
	.latest-works-section {
    background: #ffffff;


}
.contact-section {
    background: #ffffff;
}

.footer-section {
    background: #F8F7F2; /* Cream background to match your alternating pattern */
}

main{
	background: #ffffff;
    margin-top: 2rem;
}	

.about-content {
    display: grid;
    grid-template-columns: 1fr auto 1fr; /* left flexible, center auto-size, right flexible */
    gap: 2rem;
    align-items: center;
    max-width: auto;
	height: fit-content;
}

.left-text {
    text-align: center; /* Align text toward the center image */
}

.left-text h1 {
    font-size: 3rem;
    font-weight: 800;
    color: #0A3044;
    margin-bottom: 0.5rem;
    line-height: 1.1;
}

.left-text p {
    color: #0A3044; /* Green color for email like in your design */
    font-size: 1rem;
    margin-bottom: 2rem;
    text-decoration: underline;
}

.experience {
    display: flex;
    flex-direction: row; /* Change to row for side-by-side layout */
    align-items: flex-start; /* Align to top */
    margin-top: 6rem;
	margin-left: 8rem;
}

.experience .number {
    font-size: 4rem;
    font-weight: 800;
    color: #0A3044;
    line-height: 0.8;
    margin-right: 0.5rem; /* Space between number and text */
}

.experience .label {
    font-size: 1rem;
    color: #0A3044;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.1;
    display: flex;
	margin-top: 0.5rem;
    flex-direction: column; /* Stack YEARS and EXPERIENCE vertically */
}

.center-image {
    display: flex;
    justify-content: center;
    align-items: center;
}

.center-image img {
    width: 500px; /* Adjust size as needed */
    height: 500px;
    object-fit: cover;
}



.right-text {
    text-align: left; /* Align text away from center */
}

.right-text h2 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #0A3044;
    line-height: 1.2;
    margin-bottom: 3rem;
}


.help-section {
    background: #ffffff;
    padding: 70px 0 80px 0; /* Extra top padding for spacing from first section */
}

.help-container {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Two equal columns */
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    align-items: start;
}

.help-left {
    padding-right: 2rem;
}

.help-right {
    padding-left: 2rem;
}

.help-title {
    font-size: 3.5rem;
    font-weight: 700;
    color: #0A3044;
    margin-bottom: 2rem;
    line-height: 1.2;
    font-family: 'Poppins', sans-serif;
}

.help-description {
    color: #6c757d;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-family: 'Poppins', sans-serif;
}

.services-list {
    margin-bottom: 3rem;
	margin-top: 3rem;
}

.service-item {
    display: flex;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(10, 48, 68, 0.1);
}

.service-item:last-child {
    border-bottom: none;
}

.service-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 1.5rem;
    flex-shrink: 0;
}

.service-icon.teal {
    background-color: #20b2aa;
}

.service-icon.yellow {
    background-color: #ffd700;
}

.service-icon.orange {
    background-color: #ff6b47;
}

.service-icon svg {
    width: 24px;
    height: 24px;
    stroke: white;
    fill: none;
    stroke-width: 2;
}

/* Add this missing CSS for your SVG images */
.service-svg {
    width: 24px;
    height: 24px;
    filter: brightness(0) invert(1); /* Makes SVG icons white */
}

.service-content {
    flex: 1;
}

.service-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #0A3044;
    margin-bottom: 0.25rem;
    font-family: 'Poppins', sans-serif;
}

.service-count {
    color: #6c757d;
    font-size: 0.9rem;
    font-family: 'Poppins', sans-serif;
}

.stats-container {
    display: flex;
    gap: 3rem;
}

.stat-item {
    text-align: left;
}

.stat-number {
    font-size: 3rem;
    font-weight: 700;
    color: #0A3044;
    margin-bottom: 0.5rem;
    font-family: 'Poppins', sans-serif;
    line-height: 1;
}

.stat-label {
    color: #6c757d;
    font-size: 0.9rem;
    font-weight: 500;
    font-family: 'Poppins', sans-serif;
}



/* Responsive Design */
@media screen and (max-width: 1024px) {
    .help-container {
        grid-template-columns: 1fr;
        gap: 3rem;
        text-align: center;
    }
    
    .help-left,
    .help-right {
        padding: 0;
    }
    
    .help-title {
        font-size: 2.5rem;
    }
    
    .stats-container {
        justify-content: center;
        gap: 2rem;
    }
}

@media screen and (max-width: 768px) {
    .help-section {
        padding: 80px 0 60px 0;
    }
    
    .help-container {
        padding: 0 1rem;
        gap: 2rem;
    }
    
    .help-title {
        font-size: 2rem;
    }
    
    .service-icon {
        width: 50px;
        height: 50px;
        margin-right: 1rem;
    }
    
    .service-svg {
        width: 20px;
        height: 20px;
    }
    
    .stat-number {
        font-size: 2.5rem;
    }
    
    .stats-container {
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
    }
}

@media screen and (max-width: 768px) {
    .experience {
        display: none !important;
    }

    .right-text {
        margin-bottom: 2rem;
    }
}
@media screen and (max-width: 1024px) {
    .about-content {
        grid-template-columns: 1fr; /* Stack vertically on smaller screens */
        text-align: center;
        gap: 2rem;
    }
    
    .left-text, .right-text {
        text-align: center;
        padding: 0;
    }
    
    .experience, .certification {
        align-items: center;
    }
}

	@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Unbounded:wght@200..900&display=swap');
</style>